{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: core events plus Clipward's own commands. The renderer gets no direct dialog, opener or filesystem access; those go through the checked commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-settings-load",
    "allow-settings-save",
    "allow-settings-replace-api-key",
    "allow-window-set-glass",
    "allow-settings-set-appearance",
    "allow-settings-select-output-dir",
    "allow-ai-detect",
    "allow-ai-test",
    "allow-whisper-list",
    "allow-whisper-download",
    "allow-whisper-cancel",
    "allow-whisper-delete",
    "allow-job-start",
    "allow-job-cancel",
    "allow-jobs-list",
    "allow-jobs-dismiss",
    "allow-history-list",
    "allow-history-get-job",
    "allow-thumbnails-generate",
    "allow-shell-open-path",
    "allow-shell-show-item-in-folder",
    "allow-dialog-select-video",
    "allow-clips-bulk-export",
    "allow-system-is-packaged",
    "allow-system-check-tools",
    "allow-diagnostics-get-log-path",
    "allow-diagnostics-open-log-folder",
    "allow-update-check",
    "allow-update-download",
    "allow-update-install"
  ]
}
