{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipward",
  "version": "0.2.0",
  "identifier": "com.clipward.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Clipward",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 14 },
        "transparent": false,
        "backgroundColor": "#171717",
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' local-file: http://local-file.localhost https://i.ytimg.com data:",
        "media-src": "'self' local-file: http://local-file.localhost",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' local-file: http://local-file.localhost https://i.ytimg.com data:",
        "media-src": "'self' local-file: http://local-file.localhost",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../crates/engine/assets/fonts/": "assets/fonts/",
      "../crates/engine/assets/models/": "assets/models/"
    },
    "copyright": "MIT License",
    "category": "Video",
    "shortDescription": "AI clipping for content-reward campaigns",
    "longDescription": "Turn long videos into captioned clips that follow a campaign brief, with offline Whisper and your own AI CLI or API key."
  }
}
