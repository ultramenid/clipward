{
  "name": "clipward",
  "productName": "Clipward",
  "version": "0.2.0",
  "description": "Clipward: AI clipping for content-reward campaigns. Turn long videos into captioned clips that follow a campaign brief, with offline Whisper and your own AI CLI or API key.",
  "author": "Clipward",
  "license": "MIT",
  "homepage": "https://github.com/clipward/clipward",
  "repository": {
    "type": "git",
    "url": "https://github.com/clipward/clipward.git"
  },
  "bugs": {
    "url": "https://github.com/clipward/clipward/issues"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "icons": "tauri icon resources/clipward-icon.svg",
    "test:release": "node --test scripts/*.test.cjs",
    "test:renderer": "node --test tests/renderer-state.test.cjs tests/create-form.test.cjs tests/appearance.test.cjs",
    "test": "npm run test:renderer && npm run test:release && npm run test:rust",
    "test:rust": "cargo test --workspace"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.0.0",
    "zustand": "^5.0.15"
  }
}
